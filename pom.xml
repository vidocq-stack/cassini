<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.cassini</groupId>
    <artifactId>cassini-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Cassini</name>
    <description>Implémentation Jakarta RESTful Web Services 4.0 standalone — REST 4.0 pur, transport HTTP via SPI, CDI optionnel</description>
    <url>https://codeberg.org/Vidocq/cassini</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
        <developer>
            <name>Antoine Sabot Durand</name>
            <email>antoine@sabot-durand.net</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://codeberg.org/Vidocq/cassini.git</connection>
        <developerConnection>scm:git:ssh://git@forge.vidocq.dev:vidocq/cassini.git</developerConnection>
        <url>https://codeberg.org/Vidocq/cassini</url>
    </scm>

    <properties>
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.json.version>2.1.3</jakarta.json.version>
        <jakarta.json.bind.version>3.0.1</jakarta.json.bind.version>
        <jakarta.xml.bind.version>4.0.2</jakarta.xml.bind.version>
        <jakarta.activation.version>2.1.3</jakarta.activation.version>
        <champollion.version>0.1.0-SNAPSHOT</champollion.version>

        <chappe.version>0.1.0-SNAPSHOT</chappe.version>
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>
        <ravel.version>0.1.0-SNAPSHOT</ravel.version>

        <microprofile.config.version>3.1.1</microprofile.config.version>
    </properties>

    <!--
        cassini-tck est volontairement HORS reactor (POM Model 4.0.0 standalone)
        pour contourner ShrinkWrap Maven Resolver 3.3 qui ne sait pas parser
        les POMs Model 4.1.0. Il est invoqué par run-official-tck-restful-4.0.sh
        après installation locale du reactor.
    -->
    <modules>
        <module>cassini-api</module>
        <module>cassini-core</module>
        <module>cassini-processor</module>
        <module>cassini-maven-plugin</module>
        <module>cassini-cdi-vauban</module>
        <module>cassini-chappe</module>
        <module>cassini-jdk-http</module>
        <module>cassini-client</module>
        <module>cassini-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Jakarta APIs -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>${jakarta.json.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.json.bind</groupId>
                <artifactId>jakarta.json.bind-api</artifactId>
                <version>${jakarta.json.bind.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.xml.bind</groupId>
                <artifactId>jakarta.xml.bind-api</artifactId>
                <version>${jakarta.xml.bind.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.activation</groupId>
                <artifactId>jakarta.activation-api</artifactId>
                <version>${jakarta.activation.version}</version>
            </dependency>

            <!-- JSON-B / JSON-P impls : Champollion (zero-dep, JPMS strict, records natifs) -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-api</artifactId>
                <version>${champollion.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${champollion.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonb</artifactId>
                <version>${champollion.version}</version>
            </dependency>

            <!-- Chappe -->
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-api</artifactId>
                <version>${chappe.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.chappe</groupId>
                <artifactId>chappe-core</artifactId>
                <version>${chappe.version}</version>
            </dependency>

            <!-- Vauban (compile scope pour cassini-cdi-vauban) -->
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- Cassini modules internes -->
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Ravel — MicroProfile Config 3.1 (implémentation zéro-dépendance tierce) -->
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-api</artifactId>
                <version>${ravel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-cdi-vauban</artifactId>
                <version>${ravel.version}</version>
            </dependency>
            <!-- API MicroProfile Config (ré-exportée par ravel-api) -->
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${microprofile.config.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-chappe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-jdk-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-maven-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
