<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cassini</groupId>
        <artifactId>cassini-examples</artifactId>
    </parent>

    <artifactId>cassini-examples-vauban</artifactId>
    <name>Cassini :: Examples :: Vauban CDI</name>
    <description>Exemple Cassini avec intégration Vauban CDI — SeBootstrap + auto-discovery du BeanProvider Vauban</description>

    <dependencies>
        <!-- API compile : SeBootstrap + CDI + JSON-B -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <version>${vauban.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Adapter Vauban CDI : fournit BeanProvider via ServiceLoader -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-cdi-vauban</artifactId>
        </dependency>

        <!-- Transport Chappe : utilisé directement (handler composite statique + Cassini) -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- JSON-B runtime (compile + test) -->
        <dependency><groupId>io.vidocq.champollion</groupId><artifactId>champollion-jsonb</artifactId>
            </dependency>
        <dependency><groupId>io.vidocq.champollion</groupId><artifactId>champollion-jsonp</artifactId>
            </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Génère META-INF/vauban-beans.list à la compile en scannant les
                 annotations CDI (@ApplicationScoped, @RequestScoped, etc.).
                 Le runtime Vauban lira ce fichier via scanClasspath() — fonctionne
                 aussi en JPMS named module (les ressources META-INF/ sont toujours
                 accessibles, contrairement au scan de packages). -->
            <plugin>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-maven-plugin</artifactId>
                <version>${vauban.version}</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals><goal>generate</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-reads io.vidocq.cassini.examples.vauban=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
