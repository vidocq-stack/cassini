<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cassini</groupId>
        <artifactId>cassini-examples</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>cassini-examples-jdkhttp</artifactId>
    <name>Cassini :: Examples :: JDK HttpServer Standalone</name>
    <description>Cassini example with native JDK transport (com.sun.net.httpserver) — manual bootstrap via CassiniStack</description>

    <properties>
        <!-- Example code — never deployed to Maven Central. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-jdk-http</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>

        <!-- JSON-B + JSON-P runtime (required by cassini-core at runtime) -->
        <dependency><groupId>io.vidocq.champollion</groupId><artifactId>champollion-jsonb</artifactId>
            </dependency>
        <dependency><groupId>io.vidocq.champollion</groupId><artifactId>champollion-jsonp</artifactId>
            </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- Wire cassini-processor via annotationProcessorPaths so $$CassiniAdapter
                     sources are generated at compile time for @Path and @Provider classes. -->
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.cassini</groupId>
                            <artifactId>cassini-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.cassini</groupId>
                            <artifactId>cassini-api</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>jakarta.ws.rs</groupId>
                            <artifactId>jakarta.ws.rs-api</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-reads io.vidocq.cassini.examples.jdkhttp=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
