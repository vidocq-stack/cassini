<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cassini</groupId>
        <artifactId>cassini-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cassini-cdi-vauban</artifactId>
    <name>Cassini :: CDI Vauban Adapter</name>
    <description>Adapter Vauban CDI pour Cassini : implémente la SPI BeanProvider et fournit une BCE @RequestScoped pour les ressources @Path.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
        </dependency>

        <!-- Ravel MicroProfile Config — optionnel : active @ConfigProperty / @ConfigProperties CDI
             quand ravel-cdi-vauban est sur le classpath (via BCE ServiceLoader auto-découverte) -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-cdi-vauban</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Vauban codegen : génère META-INF/vauban-beans.list + _ClientProxy/_Factory pour que le
                runtime Vidocq (scanClasspath) découvre les beans CDI. BCE (CassiniScopeExtension) dans un
                package exporté → pas d'opens. Sortie inerte (Weld-safe), comme knock-cdi-vauban.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Vauban codegen now runs as an ANNOTATION PROCESSOR on this module's own beans
                        (the Maven plugin is reserved for freezing external, non-APT-processed jars).
                        The main compile generates _ClientProxy/_Factory and META-INF/vauban-beans.list
                        for the Vidocq runtime scanClasspath discovery. Build-time only: the output stays
                        inert for a standard CDI container (Weld). The module-info already `requires
                        io.vidocq.vauban.core` (compile scope), which transitively reads vauban-api.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Test fixtures are not application beans. Running the APT over them would
                         emit a provider for nested test classes (bogus package / cannot find symbol). -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
