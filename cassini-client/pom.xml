<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cassini</groupId>
        <artifactId>cassini-parent</artifactId>
    </parent>

    <artifactId>cassini-client</artifactId>
    <name>Cassini :: JAX-RS Client</name>
    <description>Implémentation Jakarta REST 4.0 Client zéro-dépendance (backend java.net.http.HttpClient + virtual threads)</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
        </dependency>
        <!-- @Priority pour résoudre l'ordre des Client*Filter — provided car uniquement
             utilisé en compile-time (les annotations sont lisibles via réflexion sans
             le module au runtime). -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
