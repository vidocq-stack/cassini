<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cassini</groupId>
        <artifactId>cassini-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cassini-client</artifactId>
    <name>Cassini :: JAX-RS Client</name>
    <description>Zero-dependency Jakarta REST 4.0 Client implementation (java.net.http.HttpClient backend + virtual threads)</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
        </dependency>
        <!-- @Priority to resolve Client*Filter ordering — provided because it is only
             used at compile time (the annotations remain readable via reflection without
             the module at runtime). -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- The JSON-B implementation comes from the application or its runtime; the tests use
             Champollion to round-trip JSON entities. -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludedGroups>without-jsonb</excludedGroups>
                            <!-- @{argLine} keeps the JaCoCo agent of the quality profile (vidocq-parent);
                                 Champollion binds the POJOs of the tests. -->
                            <argLine>@{argLine} --add-opens io.vidocq.cassini.client/io.vidocq.cassini.client=io.vidocq.champollion.jsonb</argLine>
                        </configuration>
                    </execution>
                    <!-- CASSINI-018: a client that never handles JSON must work without a JSON-B
                         provider, so these tests run with Champollion's JSON-B left out. -->
                    <execution>
                        <id>without-jsonb</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>without-jsonb</groups>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>io.vidocq.champollion:champollion-jsonb</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
