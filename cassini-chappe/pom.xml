<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cassini</groupId>
        <artifactId>cassini-parent</artifactId>
    </parent>

    <artifactId>cassini-chappe</artifactId>
    <name>Cassini :: Chappe HTTP Adapter</name>
    <description>Adapter HTTP pour Chappe — implémente CassiniHttpAdapter via fr.vidocq.chappe (transport de référence)</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
        </dependency>
        <!-- CDI API : ChappeRuntimeDelegate utilise Invoker.forBeanManager
             via le runtime — accessible en provided. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
