<?xml version="1.0" encoding="UTF-8"?>
<!--
    Projet Maven STANDALONE en Model Version 4.0.0, volontairement EN DEHORS
    du reactor Cassini.

    Pourquoi : ShrinkWrap Maven Resolver 3.3 (dép. transitive du TCK Jakarta)
    utilise maven-resolver 1.9 / maven-model 3.9 qui ne savent pas parser
    les POMs Model 4.1.0 du reactor. Son ClasspathWorkspaceReader
    crash avec "Bad artifact coordinates ... jar:".

    Dépendances internes (cassini-core, cassini-chappe, etc.) sont gelées
    sur la version 0.1.0-SNAPSHOT installée dans le repo M2 local.

    Le lancement passe par le script :
        ./run-official-tck-restful-4.0.sh                       (smoke test)
        ./run-official-tck-restful-4.0.sh all                   (suite complète)
        ./run-official-tck-restful-4.0.sh -Dtest=SomeTests      (classe ciblée)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.vidocq.cassini</groupId>
    <artifactId>cassini-tck</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Cassini :: TCK Runner</name>
    <description>Harness de conformance Jakarta RESTful Web Services 4.0 — point d'entrée pour le TCK officiel</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <cassini.version>0.1.0-SNAPSHOT</cassini.version>
        <chappe.version>0.1.0-SNAPSHOT</chappe.version>
    </properties>

    <repositories>
        <repository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
            <version>${chappe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <version>${chappe.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <!-- CDI API : cassini-core déclare Invoker.forBeanManager(BeanManager).
             Le harness TCK appelle cette méthode → besoin du JAR à la compilation. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.1.0</version>
        </dependency>
        <!-- Servlet API : certaines ressources TCK déclarent @Context HttpServletRequest.
             Cassini ne supporte pas l'injection servlet, mais sans l'API au classpath
             le scan reflexif (Class.getDeclaredMethods) crash en NoClassDefFoundError. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.container</groupId>
            <artifactId>arquillian-container-spi</artifactId>
            <version>1.8.0.Final</version>
            <scope>test</scope>
        </dependency>
        <!-- Jersey CLIENT en test-scope (hors profil tck-official) :
             les classes test/AutoDiscover et MultipartBoundaryFilter dépendent
             de l'API jersey-common (AutoDiscoverable). À l'exécution TCK, le
             profil tck-official ré-installe les versions complètes. -->
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-common</artifactId>
            <version>4.0.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- Wire cassini-processor on the annotation-processor path.
                     This generates compile-time $$CassiniAdapter for @Path and @Provider
                     classes in this module. AdapterRegistry.lookup uses Class.forName
                     (APT path) before the runtime Class-File generator — AOT-safe.
                     Note: annotationProcessorPaths is deprecated in compiler 4.x but
                     still functional; the type=processor alternative causes a javac ICE
                     with JPMS named-module processors on Java 25. -->
                <configuration>
                    <release>25</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.cassini</groupId>
                            <artifactId>cassini-processor</artifactId>
                            <version>${cassini.version}</version>
                        </path>
                        <path>
                            <groupId>io.vidocq.cassini</groupId>
                            <artifactId>cassini-api</artifactId>
                            <version>${cassini.version}</version>
                        </path>
                        <path>
                            <groupId>jakarta.ws.rs</groupId>
                            <artifactId>jakarta.ws.rs-api</artifactId>
                            <version>4.0.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>tck-official</id>
            <build>
                <plugins>
                    <!--
                        P3: cassini-maven-plugin:generate pre-generates $$CassiniAdapter
                        bytecode for @Path/@Provider classes arriving in the TCK jar
                        (jakarta-restful-ws-tck) — an external pre-compiled archive that
                        the APT processor cannot reach. This closes AOT coverage:
                        AdapterRegistry.lookup tries Class.forName first, so plugin-generated
                        adapters are picked up without invoking the runtime Class-File generator.
                    -->
                    <plugin>
                        <groupId>io.vidocq.cassini</groupId>
                        <artifactId>cassini-maven-plugin</artifactId>
                        <version>${cassini.version}</version>
                        <executions>
                            <execution>
                                <id>generate-tck-adapters</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <!-- Scan dependency JARs, specifically the TCK archive.
                                         The TCK jar (jakarta-restful-ws-tck) is a plain classpath
                                         jar (no module-info) so no repackaging is needed. -->
                                    <scope>dependencies</scope>
                                    <includeArtifacts>
                                        <includeArtifact>jakarta.ws.rs:jakarta-restful-ws-tck</includeArtifact>
                                    </includeArtifacts>
                                    <!-- Write adapters to test-classes so they are on the
                                         surefire test classpath alongside the TCK jar -->
                                    <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-tck-workdir-pom</id>
                                <phase>process-test-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/tck-workdir</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/test/tck-resources</directory>
                                            <includes><include>pom.xml</include></includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>jakarta.ws.rs:jakarta-restful-ws-tck</dependency>
                            </dependenciesToScan>
                            <!-- Profil Jakarta EE Core Profile / SE-Bootstrap : certif standalone
                                 Jakarta RESTful Web Services 4.0 sans Servlet container ni JAXB.
                                 Tags M2h (async, sse-streaming) préparés pour activation future.
                                 - servlet     : exige HttpServletRequest, hors scope SE
                                 - xml_binding : exige JAXB-runtime, hors Core Profile
                                 - async       : refactor non-bloquant (M2h, hors scope MVP)
                                 - sse-streaming : streaming chunked SSE (M2i, hors scope MVP) -->
                            <excludedGroups>servlet,xml_binding</excludedGroups>
                            <includes>
                                <include>**/*IT.class</include>
                                <include>**/*Test.class</include>
                                <include>**/*Tests.class</include>
                            </includes>
                            <workingDirectory>${project.build.directory}/tck-workdir</workingDirectory>
                            <trimStackTrace>false</trimStackTrace>
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <systemPropertyVariables>
                                <webServerHost>127.0.0.1</webServerHost>
                                <webServerPort>8080</webServerPort>
                                <ts_home>${project.build.directory}/test-classes</ts_home>
                                <user>j2ee</user>
                                <password>j2ee</password>
                                <authuser>javajoe</authuser>
                                <authpassword>javajoe</authpassword>
                                <jimage.dir>${project.build.directory}/jimage</jimage.dir>
                                <sigTestClasspath>${user.home}/.m2/repository/jakarta/ws/rs/jakarta.ws.rs-api/4.0.0/jakarta.ws.rs-api-4.0.0.jar${path.separator}${project.build.directory}/jimage/java.base${path.separator}${project.build.directory}/jimage/java.xml</sigTestClasspath>
                                <jakarta.ws.rs.ext.RuntimeDelegate>io.vidocq.cassini.chappe.ChappeRuntimeDelegate</jakarta.ws.rs.ext.RuntimeDelegate>
                            </systemPropertyVariables>
                            <argLine>-Djdk.httpclient.allowRestrictedHeaders=host,connection,content-length,expect,upgrade,origin,date,via,cookie</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>jakarta.ws.rs</groupId>
                    <artifactId>jakarta-restful-ws-tck</artifactId>
                    <version>4.0.1</version>
                    <scope>test</scope>
                </dependency>
                <!-- Jersey CLIENT : le TCK est côté serveur, mais utilise un Client
                     pour piloter le serveur sous test. Cassini n'a pas de Client. -->
                <dependency>
                    <groupId>org.glassfish.jersey.core</groupId>
                    <artifactId>jersey-client</artifactId>
                    <version>4.0.2</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.glassfish.jersey.inject</groupId>
                    <artifactId>jersey-hk2</artifactId>
                    <version>4.0.2</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.glassfish.jersey.media</groupId>
                    <artifactId>jersey-media-jaxb</artifactId>
                    <version>4.0.2</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.glassfish.jaxb</groupId>
                    <artifactId>jaxb-runtime</artifactId>
                    <version>4.0.5</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.glassfish.jersey.media</groupId>
                    <artifactId>jersey-media-sse</artifactId>
                    <version>4.0.2</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.glassfish.jersey.media</groupId>
                    <artifactId>jersey-media-json-binding</artifactId>
                    <version>4.0.2</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>jakarta.tck</groupId>
                    <artifactId>sigtest-maven-plugin</artifactId>
                    <version>2.5</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.shrinkwrap</groupId>
                    <artifactId>shrinkwrap-api</artifactId>
                    <version>1.2.6</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.shrinkwrap</groupId>
                    <artifactId>shrinkwrap-impl-base</artifactId>
                    <version>1.2.6</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                    <version>2.0.16</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                    <version>2.0.16</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                    <version>4.13.2</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
