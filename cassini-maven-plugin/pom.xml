<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cassini</groupId>
        <artifactId>cassini-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cassini-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Cassini :: Maven Plugin</name>
    <description>
        Maven plugin that pre-generates CassiniAdapter bytecode at build time for resource
        classes arriving as pre-compiled .class in external dependency JARs (the APT processor
        cannot reach those). Closes AOT coverage for GraalVM native-image and Project Leyden CDS.
    </description>

    <dependencies>
        <!-- Cassini core — provides RuntimeAdapterGenerator.toBytecode(). -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
        </dependency>
        <!-- Jakarta WS RS API — needed at classloading time inside the Mojo classloader -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>

        <!-- Maven plugin API — using 3.9.x to ensure v3 classloader compatibility.
             Maven 4 (rc-5) is backward-compatible with v3 mojos. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <proc>none</proc>
                </configuration>
            </plugin>
            <!--
                Pinned to maven-plugin-plugin 3.15.1 (Maven 3.9.x compatible, Java 25 class files
                supported). requiredMavenVersion remains "3.2.5" — the cassini plugin only uses
                AbstractMojo and doesn't depend on any Maven 4 API.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.2</version>
                <configuration>
                    <goalPrefix>cassini</goalPrefix>
                    <requiredMavenVersion>3.2.5</requiredMavenVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
